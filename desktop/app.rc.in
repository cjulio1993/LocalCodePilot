// Template for the Windows resource. build.rs fills the @...@ markers from the
// package version (Cargo.toml) and compiles the result; never write a version here.
1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @VERSION_NUMBERS@
PRODUCTVERSION @VERSION_NUMBERS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LocalCodePilot\0"
            VALUE "FileDescription", "LocalCodePilot Desktop\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "LocalCodePilot.exe\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 LocalCodePilot contributors\0"
            VALUE "OriginalFilename", "LocalCodePilot.exe\0"
            VALUE "ProductName", "LocalCodePilot\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
